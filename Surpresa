<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Para Lívia ❤️</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Arial', sans-serif;
      background-color: #f28b8b;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .container {
      text-align: center;
    }

    button {
      padding: 15px 30px;
      font-size: 18px;
      border: none;
      border-radius: 30px;
      cursor: pointer;
      background-color: #ffffff;
      color: #c0392b;
      font-weight: bold;
      transition: transform 0.1s, background-color 0.2s;
      position: absolute;
    }

    button:hover {
      transform: scale(1.05);
      background-color: #ffe6e6;
    }

    #surprise {
      display: none;
      max-width: 90%;
      background-color: rgba(255, 255, 255, 0.9);
      padding: 20px;
      border-radius: 20px;
      position: relative;
      margin: auto;
    }

    #surprise img {
      max-width: 100%;
      border-radius: 15px;
      margin-bottom: 15px;
    }

    h1 {
      color: #c0392b;
    }

    p {
      color: #555;
      font-size: 16px;
    }
  </style>
</head>
<body>

  <div class="container" id="firstScreen">
    <button id="firstButton">CLIQUE AQUI</button>
  </div>

  <div class="container" id="surprise">
    <h1>Para Lívia Rodrigues ❤️</h1>
    <img src="eb100278-600f-47d5-bbbb-5a26d8c6c0b9.jpg" alt="Nossa foto">
    <p>
      Meu amor, você é uma mulher incrível e eu sou seu fã. Te amo meu amor e obrigado por fazer minha vida ter mais sentido.
    </p>
  </div>

  <script>
    const firstButton = document.getElementById('firstButton');
    const surprise = document.getElementById('surprise');
    let clicks = 0;

    function moveButtonRandom() {
      const x = Math.random() * (window.innerWidth - 150);
      const y = Math.random() * (window.innerHeight - 60);
      firstButton.style.left = x + 'px';
      firstButton.style.top = y + 'px';
    }

    firstButton.addEventListener('mouseover', () => {
      moveButtonRandom();
    });

    firstButton.addEventListener('click', () => {
      clicks++;
      if (clicks < 5) {
        for (let i = 0; i < 3; i++) {
          setTimeout(moveButtonRandom, Math.random() * 100);
        }
      } else {
        surprise.style.display = 'block';
        firstButton.style.display = 'none';
      }
    });
  </script>

</body>
</html>
